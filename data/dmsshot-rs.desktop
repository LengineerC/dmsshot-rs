[Desktop Entry]
Name=dmsshot-rs
GenericName=Screenshot Capture Utility
Comment=Native Wayland screenshot, scrolling capture, and OCR utility
Exec=/usr/bin/dmsshot-rs
TryExec=/usr/bin/dmsshot-rs
Icon=camera-photo
Terminal=false
StartupNotify=false
Type=Application
NoDisplay=true
Categories=Graphics;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
